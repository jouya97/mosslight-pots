+import sys, copy; sys.path.insert(0,'/workspace')
+from mosslight import create, step
+from mosslight.commands import execute
+from mosslight.save_merge import reconcile, verify_receipt
+b=create(34,8,6); execute(b,{"op":"note","args":{"content":"base note","labels":["a"]}})
+L=copy.deepcopy(b); R=copy.deepcopy(b)
+execute(L,{"op":"note","args":{"content":"left note"}})
+execute(R,{"op":"note","args":{"content":"right note"}})
+execute(L,{"op":"edit_note","args":{"ident":1,"content":"edited left"}})
+execute(R,{"op":"edit_note","args":{"ident":1,"labels":["b"]}})
+r=reconcile(b.to_dict(),L.to_dict(),R.to_dict(),left_origin='desk',right_origin='field')
+print(r['status'], r.get('conflicts'))
+if r['status']=='ready':
+    print([(n['id'],n['text'],n['tags']) for n in r['world']['workbench']['notes']], r['world']['workbench']['next_id'])
+    print(r['receipt']['allocation'])
+    r2=reconcile(b.to_dict(),R.to_dict(),L.to_dict(),left_origin='field',right_origin='desk')
+    print(r2['world']==r['world'])
+    print(verify_receipt(r,b.to_dict(),L.to_dict(),R.to_dict(),left_origin='desk',right_origin='field'))
