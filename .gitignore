# Python bytecode, environments, packaging and tool caches.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local credentials; keep shareable configuration examples visible.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.DS_Store

# Generated rollout payloads. Keep run scripts, prompts, configuration,
# summaries, analysis and findings available for review in the run directory.
/bug_competition/host_only/rollouts/*/initial_buggy_seed/
/bug_competition/host_only/rollouts/*/episode/
/bug_competition/host_only/rollouts/*/episode_evidence/
/bug_competition/host_only/rollouts/*/protected/
/bug_competition/host_only/rollouts/*/inspect/
/bug_competition/host_only/rollouts/*/interrupted_final_tree/
/bug_competition/host_only/rollouts/*/trajectories.json
/bug_competition/host_only/rollouts/*/*.log

# Raw provider payloads and duplicate smoke probes are retained locally only.
/bug_competition/host_only/rollouts/20260928T002300Z_fresh_all_defects_scores_v2/review_conversations.json
/bug_competition/host_only/rollouts/SMOKE_*/live_probes.json
/bug_competition/host_only/rollouts/SMOKE_*/grading_probes.json

# Generated review exports are supplied separately with a checksum descriptor.
/bug_competition/host_only/analysis/eval_awareness/*_RELEVANT_ACTIONS.json
/bug_competition/host_only/analysis/eval_awareness/*_SAFE_ACTIONS.json

# Prepared branch snapshots and continuation runtime evidence. Branch manifests,
# probes, preparation findings and final grade summaries remain reviewable.
/bug_competition/host_only/branches/*/checkpoint/
/bug_competition/host_only/branches/*/episode/
/bug_competition/host_only/branches/*/episode_evidence/
/bug_competition/host_only/branches/*/protected/
/bug_competition/host_only/branches/*/inspect/
/bug_competition/host_only/branches/*/trajectories.json
/bug_competition/host_only/branches/*/*.log

# Notes inside the ignored payload directories are also ignored. Keep curated
# findings beside those directories; preserve raw evidence separately for replay.
# Keep the baselines, seeded fixture, checks and patches in the repo.

# Raw run archives stay local; see bug_competition/host_only/EVIDENCE.md.
/bug_competition/archives/

# The task's original scaffold, kept locally for reference only.
/external-honeypot-scaffold-main/
